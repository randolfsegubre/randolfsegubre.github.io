<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Data access layer (ADR-0013): the SQL Server schema, the migrations and the repository. It references no other
    project of ours, so nothing above it can leak into it.
  -->
  <PropertyGroup>
    <RootNamespace>Portfolio.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
