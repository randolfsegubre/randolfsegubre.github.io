@using Portfolio.Web.Content
@*
    The hidden logo sprite (ADR-0008): every technology logo drawn exactly once as an SVG
    <symbol>. The hero's logo rail and the faint page layer reference these with <use>, so the
    page stays small however many times a logo repeats. The sprite is zero-sized and hidden
    from assistive technology; it draws nothing by itself.
*@
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
        @foreach (var logo in TechLogoData.Logos)
        {
            <symbol id="@logo.SymbolId" viewBox="0 0 24 24">@Html.Raw(logo.Markup)</symbol>
        }
    </defs>
</svg>
