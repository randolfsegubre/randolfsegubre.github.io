@*
    The page shell shared by every view (ADR-0002).
    It owns the document head, the skip link, the header and footer, and the single
    <main> landmark that each view's content is rendered into.
*@
@inject Portfolio.Web.Content.IPortfolioContent Content
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Portfolio of Randolf Segubre, a senior full-stack .NET developer with 9+ years across travel, healthcare and construction. Selected projects, experience and contact." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="Selected projects, experience and skills of a senior full-stack .NET developer based in Metro Manila, Philippines." />
    <meta property="og:url" content="https://randolfsegubre.github.io/" />
    @if (Content.Profile.PhotoUrl is not null)
    {
        @* Link previews (email, LinkedIn, chat apps) show the portrait. Absolute address, as previews require. *@
        <meta property="og:image" content="https://randolfsegubre.github.io@(Content.Profile.PhotoUrl)" />
        <meta property="og:image:alt" content="@Content.Profile.PhotoAlt" />
        <meta name="twitter:card" content="summary" />
    }
    <meta name="theme-color" content="#1a0b3b" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <script>
        // STEP 1 of 2: mark the page as scripted, so scroll-reveal styles only hide
        // content when the script that reveals it is actually going to run.
        document.documentElement.classList.add("js");
        // STEP 2 of 2: apply a remembered manual theme choice before first paint so the
        // page never flashes the wrong theme. With no saved choice, dark is the default.
        try {
            var saved = localStorage.getItem("theme");
            if (saved === "light" || saved === "dark") {
                document.documentElement.setAttribute("data-theme", saved);
            }
        } catch (e) { }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* Animated background fixed behind the whole page (code lanes and floating logos), so the motion covers every section as the visitor scrolls (ADR-0008). *@
    <partial name="_CodeStreams" model="@("page")" />
    <partial name="_TechLogos" model="@(new TechLogosModel(Content.Profile.BackdropTags, "page"))" />
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <a class="skip-link" href="#main">Skip to main content</a>
    <partial name="_Header" />
    <main id="main">
        @RenderBody()
    </main>
    <partial name="_Footer" />
    <script src="~/js/theme.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</body>
</html>
