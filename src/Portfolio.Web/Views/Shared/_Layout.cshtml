@*
    The page shell shared by every view (ADR-0007).
    It owns the document head, the skip link, the header and footer, and the single
    <main> landmark that each view's content is rendered into.
*@
@inject Portfolio.Web.Content.IPortfolioContent Content
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* Content Security Policy (ADR-0009). GitHub Pages cannot send headers, so the policy rides in a meta tag.
       Scripts and styles may only come from this site; the one allowance is style="" attributes, which carry
       per-element animation values. frame-ancestors and similar header-only directives cannot be set here. *@
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'none'; manifest-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Portfolio of Randolf Segubre, a full-stack .NET developer with 9+ years of C# and .NET experience across travel, healthcare and construction. Selected projects, experience and contact." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="Selected projects, experience and skills of a full-stack .NET developer based in Metro Manila, Philippines." />
    <meta property="og:url" content="@Portfolio.Web.Content.SiteInfo.Url/" />
    @if (ViewData["NoIndex"] is true)
    {
        @* The not-found page must never compete with the real page in search results. *@
        <meta name="robots" content="noindex" />
    }
    else
    {
        <link rel="canonical" href="@Portfolio.Web.Content.SiteInfo.Url/" />
    }
    <meta name="twitter:title" content="@ViewData["Title"]" />
    <meta name="twitter:description" content="Selected projects, experience and skills of a full-stack .NET developer based in Metro Manila, Philippines." />
    @if (Content.Profile.PhotoUrl is not null)
    {
        @* Link previews (email, LinkedIn, chat apps) show the portrait. Absolute address, as previews require. *@
        <meta property="og:image" content="@Portfolio.Web.Content.SiteInfo.Url@(Content.Profile.PhotoUrl)" />
        <meta property="og:image:width" content="640" />
        <meta property="og:image:height" content="640" />
        <meta property="og:image:alt" content="@Content.Profile.PhotoAlt" />
        <meta name="twitter:card" content="summary" />
    }
    <meta name="theme-color" content="#1a0b3b" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* Animated background fixed behind the whole page (code lanes and floating logos), so the motion covers every section as the visitor scrolls (ADR-0008). *@
    <partial name="_CodeStreams" model="@("page")" />
    <partial name="_LogoSprite" />
    <partial name="_TechLogos" model="Content.Profile.BackdropTags.Skip(Portfolio.Web.Content.TechLogoData.HeroLogoCount).ToList()" />
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <a class="skip-link" href="#main">Skip to main content</a>
    <partial name="_Header" />
    <main id="main">
        @RenderBody()
    </main>
    <partial name="_Footer" />
    <script src="~/js/theme.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</body>
</html>
