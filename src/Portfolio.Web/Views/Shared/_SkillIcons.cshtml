@using Portfolio.Web.Content
@*
    The hidden sprite for the skills map's own icons (ADR-0010): the extra logo and the generic line
    glyphs, each drawn once as an SVG <symbol>. The technology logos the map also uses live in the
    page-wide sprite (_LogoSprite). Zero-sized and hidden from assistive technology; it draws nothing
    by itself.
*@
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
        @foreach (var icon in SkillIconData.Icons)
        {
            <symbol id="@icon.SymbolId" viewBox="0 0 24 24">@Html.Raw(icon.Markup)</symbol>
        }
    </defs>
</svg>
