@model IReadOnlyList<string>
@using Portfolio.Web.Content
@*
    The faint page layer of technology logos (ADR-0008): quiet silhouettes in the theme color,
    fixed behind the whole page at low opacity so the technology theme continues in every
    section. The bright, readable logos live in the hero's logo rail (_LogoRail.cshtml); these
    are only ambience, so they sit behind the content and never carry meaning.

    Each logo is a reference to the shared sprite (_LogoSprite.cshtml). A technology with no
    logo in TechLogoData is skipped. Purely decorative, so the whole layer is hidden from
    assistive technology. Slots marked "edge" stay on phones, where only a few are shown.
*@
@{
    // x = left; either y (from the top) or b (from the bottom); edge = keep on phones.
    var slots = new (string X, string? Y, string? B, bool Edge, int Seconds, int Delay)[]
    {
        ("6%", "14%", null, true, 16, -2),
        ("90%", "10%", null, true, 18, -6),
        ("3%", "52%", null, false, 15, -4),
        ("95%", "48%", null, false, 17, -1),
        ("12%", null, "10%", true, 19, -9),
        ("48%", null, "6%", false, 16, -7),
        ("88%", null, "12%", false, 18, -3),
        ("30%", "34%", null, false, 20, -5),
        ("70%", "26%", null, false, 17, -8),
        ("52%", "60%", null, false, 19, -2),
        ("22%", "72%", null, false, 16, -6),
        ("78%", "84%", null, false, 18, -4),
    };
    var placed = 0;
}
<div class="tech-logos tech-logos--page" aria-hidden="true">
    @foreach (var tech in Model)
    {
        var logo = TechLogoData.Find(tech);
        if (logo is null || placed >= slots.Length)
        {
            continue;
        }

        var slot = slots[placed++];
        var position = $"--x:{slot.X};" + (slot.Y is not null ? $"--y:{slot.Y};" : $"--b:{slot.B};") + $"--d:{slot.Seconds}s;--delay:{slot.Delay}s;--brand:{logo.Hex}";
        var cssClass = "tech-logo" + (slot.Edge ? " tech-logo--edge" : string.Empty);
        <span class="@cssClass" style="@position" data-tech="@logo.Key"><svg viewBox="0 0 24 24" focusable="false"><use href="#@logo.SymbolId" /></svg></span>
    }
</div>
