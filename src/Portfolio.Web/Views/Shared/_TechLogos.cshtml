@model IReadOnlyList<string>
@using Portfolio.Web.Content
@*
    Quiet technology logos scattered around the page (ADR-0008): faint silhouettes with a very
    slow drift, so they read as background texture and never as content. Pass
    ViewData["variant"] = "hero" for the layer inside the hero (positioned by percentage of the
    hero, drawn in the hero's light text color) or leave it as the default "page" for the layer
    fixed behind every other section (drawn in the theme's accent color).

    The caller gives each layer its own share of the technologies (see _CodeBackdrop.cshtml and
    _Layout.cshtml), so every logo appears once, not twice. Each logo is a reference to the shared
    sprite (_LogoSprite.cshtml); a technology with no logo in TechLogoData is skipped. Purely
    decorative, so the layer is hidden from assistive technology. Slots marked "edge" stay on
    phones, where only a few are shown.
*@
@{
    var variant = ViewData["variant"] as string ?? "page";

    // x = left; either y (from the top) or b (from the bottom); edge = keep on phones.
    // Hero slots sit in the hero's top padding (a fixed 1rem from its top edge), which is about 4rem tall and
    // never holds content at any screen size, so these logos can never land on the portrait, name or text.
    var heroSlots = new (string X, string? Y, string? B, bool Edge, int Seconds, int Delay)[]
    {
        ("6%", "0.8rem", null, true, 15, -2),
        ("46%", "0.8rem", null, false, 17, -6),
        ("86%", "0.8rem", null, true, 16, -4),
    };
    var pageSlots = new (string X, string? Y, string? B, bool Edge, int Seconds, int Delay)[]
    {
        ("6%", "14%", null, true, 16, -2),
        ("90%", "10%", null, true, 18, -6),
        ("3%", "52%", null, false, 15, -4),
        ("95%", "48%", null, false, 17, -1),
        ("12%", null, "10%", true, 19, -9),
        ("48%", null, "6%", false, 16, -7),
        ("88%", null, "12%", false, 18, -3),
        ("30%", "34%", null, false, 20, -5),
        ("70%", "26%", null, false, 17, -8),
        ("56%", "62%", null, false, 19, -2),
    };
    var slots = variant == "hero" ? heroSlots : pageSlots;
    var placed = 0;
}
<div class="tech-logos tech-logos--@variant" aria-hidden="true">
    @foreach (var tech in Model)
    {
        var logo = TechLogoData.Find(tech);
        if (logo is null || placed >= slots.Length)
        {
            continue;
        }

        var slot = slots[placed++];
        var position = $"--x:{slot.X};" + (slot.Y is not null ? $"--y:{slot.Y};" : $"--b:{slot.B};") + $"--d:{slot.Seconds}s;--delay:{slot.Delay}s";
        var cssClass = "tech-logo" + (slot.Edge ? " tech-logo--edge" : string.Empty);
        <span class="@cssClass" style="@position" data-tech="@logo.Key"><svg viewBox="0 0 24 24" focusable="false"><use href="#@logo.SymbolId" /></svg></span>
    }
</div>
