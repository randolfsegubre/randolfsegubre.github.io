@model Profile
@*
    The first screen: portrait, name, title, the pitch, availability and the main calls to
    action, beside a code card that renders the same profile as a C# record, over an
    animated background of scrolling code and floating technology tags (ADR-0008). It holds
    the page's only <h1>. The resume button renders only when ResumeUrl is set, so the site
    never shows a dead download link, and the portrait only when PhotoUrl is set.
*@
<section id="top" class="hero" aria-labelledby="hero-heading">
    <partial name="_CodeBackdrop" model="Model" />
    <div class="container hero-grid">
        <div class="hero-copy">
            <div class="hero-identity">
                @if (Model.PhotoUrl is not null)
                {
                    @* The portrait is above the fold, so it is neither lazy-loaded nor left without a size (avoids layout shift). *@
                    <img class="avatar" src="@Model.PhotoUrl" alt="@Model.PhotoAlt" width="160" height="160" decoding="async" fetchpriority="high" />
                }
                <div class="hero-identity-text">
                    @* Decorative crown: royal purple and gold is the site's identity. Hidden from assistive technology. *@
                    <svg class="crown" viewBox="0 0 64 44" aria-hidden="true" focusable="false">
                        <path d="M4 38 L1 10 L17 24 L32 4 L47 24 L63 10 L60 38 Z" fill="currentColor" />
                        <rect x="4" y="40" width="56" height="4" rx="2" fill="currentColor" />
                        <circle cx="1" cy="9" r="2.5" fill="currentColor" />
                        <circle cx="32" cy="3" r="2.5" fill="currentColor" />
                        <circle cx="63" cy="9" r="2.5" fill="currentColor" />
                    </svg>
                    <p class="eyebrow">@Model.Title</p>
                    <h1 id="hero-heading" class="hero-title">@Model.Name</h1>
                </div>
            </div>
            <hr class="hero-rule" />
            <p class="hero-lead">@Model.Headline</p>
            <p class="hero-meta">
                <span>@Model.Location</span>
                <span aria-hidden="true"> &middot; </span>
                <span>@Model.Availability</span>
            </p>
            <div class="hero-actions">
                <a class="button button-primary" href="#projects">See selected projects</a>
                <a class="button" href="@("mailto:" + Model.Email)">Email me</a>
                @if (Model.ResumeUrl is not null)
                {
                    <a class="button" href="@Model.ResumeUrl" download>Download resume</a>
                }
                @foreach (var link in Model.Links)
                {
                    <partial name="_ExternalLink" model="link" view-data="@(new ViewDataDictionary(ViewData) { { "class", "button" } })" />
                }
            </div>
        </div>
        <partial name="_DeveloperRecord" model="Model" />
    </div>
</section>
