@model Profile
@*
    How to reach the owner, as a row of large link cards: email first, then profiles.
    Email is a plain mailto: link, not a form, because a form would need a third-party
    service (ADR-0001).
*@
<section id="contact" class="section section-contact" aria-labelledby="contact-heading">
    <div class="container">
        <h2 id="contact-heading" class="section-title" data-reveal>Let's talk</h2>
        <p class="section-intro" data-reveal>@Model.Availability</p>
        <ul class="contact-list">
            <li class="contact-card" data-reveal>
                <span class="contact-label">Email</span>
                <a class="contact-link" href="@("mailto:" + Model.Email)">@Model.Email</a>
            </li>
            @foreach (var link in Model.Links)
            {
                var shownAddress = new Link(link.Href.Replace("https://", string.Empty), link.Href);
                <li class="contact-card" data-reveal>
                    <span class="contact-label">@link.Label</span>
                    <partial name="_ExternalLink" model="shownAddress" view-data="@(new ViewDataDictionary(ViewData) { { "class", "contact-link" } })" />
                </li>
            }
            <li class="contact-card" data-reveal>
                <span class="contact-label">Location</span>
                <span class="contact-value">@Model.Location</span>
            </li>
        </ul>
    </div>
</section>
