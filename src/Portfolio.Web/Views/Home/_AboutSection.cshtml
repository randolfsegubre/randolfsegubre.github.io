@using Portfolio.Web.Content
@using System.Globalization
@model AboutSectionModel
@*
    "About me" and the skills together (ADR-0010): his own paragraphs, then every skill and technology as
    a cloud of spheres with .NET at the centre, on a purple band like the hero and footer, and the full
    grouped list kept in an ordinary section underneath. This view only draws what the data says; the
    words live in ProfileData and SkillUniverseData, the positions come from SkillUniverseLayout
    (ADR-0003).

    Works without script: the cloud is a 3D scene, so without script the map is hidden and every
    caption is listed instead. With script (site.js, STEP 5) the markup becomes a floating, rotatable
    3D cloud: each star carries its depth and its place on the sphere (data-depth, data-azimuth,
    data-elevation, data-radius) so the script only has to project it, and a star becomes a button that
    lights its connections and shows its caption.
*@
@{
    var map = Model.Map;

    // Numbers become attribute text, so they must never pick up a comma decimal from the machine's culture.
    string N(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
<partial name="_SkillIcons" />
<section id="about" class="section section-about about-band" aria-labelledby="about-heading">
    <div class="container">
        <h2 id="about-heading" class="section-title" data-reveal>About Me</h2>
        <div class="about-grid">
            <div class="about-copy" data-reveal>
                @foreach (var paragraph in Model.Paragraphs)
                {
                    <p>@paragraph</p>
                }
            </div>

            <div class="about-skills-intro" data-reveal>
                <h3 id="skills-heading" class="about-sub">Skills</h3>
                <p class="section-intro">@map.Intro</p>
            </div>
        </div>

        <div class="universe" data-universe data-journey="@string.Join(',', map.Journey)" data-reveal>
            <div class="universe-bar">
                <button type="button" class="universe-walk" data-universe-walk hidden>Walk my journey</button>
                <button type="button" class="universe-control" data-universe-spin hidden>Pause rotation</button>
                <button type="button" class="universe-control" data-universe-turn="-1" hidden>Turn left</button>
                <button type="button" class="universe-control" data-universe-turn="1" hidden>Turn right</button>
                <span class="universe-hint">Drag or swipe to turn it. Choose a sphere to bring it to the front.</span>
            </div>

            <div class="universe-scroll" role="region" aria-label="Skills cloud. Drag it or use the arrow keys to turn it." tabindex="0">
                <div class="universe-map">
                    @* Dust and lines are drawn as decoration; the stars below carry the meaning. Script positions all of it in 3D. *@
                    <svg class="universe-lines" viewBox="0 0 1000 1000" aria-hidden="true" focusable="false">
                        @foreach (var link in map.Links)
                        {
                            <line class="universe-link" data-link-from="@link.FromId" data-link-to="@link.ToId" />
                        }
                    </svg>
                    <ul class="universe-stars" aria-label="Technologies in the cloud">
                        @foreach (var placed in map.Stars)
                        {
                            var icon = SkillIconData.Find(placed.Star.Icon)!;
                            <li class="star star-depth-@placed.Depth@(placed.Star.Main ? " star-main" : "")@(icon.OnDark ? " tone-dark" : "")" data-star="@placed.Star.Id" data-depth="@placed.Depth" data-azimuth="@N(placed.Azimuth)" data-elevation="@N(placed.Elevation)" data-radius="@N(placed.Radius)"><span class="orb" aria-hidden="true"><svg class="orb-icon" viewBox="0 0 24 24" fill="@icon.Fill" focusable="false"><use href="#@icon.SymbolId" /></svg></span><span class="star-name@(placed.Depth == 0 ? " visually-hidden" : "")">@placed.Star.Label</span></li>
                        }
                    </ul>
                </div>
            </div>

            @* Script shows one caption at a time in a live region; without script this whole list is the caption view. *@
            <ul class="universe-captions" aria-label="Where I used each technology">
                @foreach (var placed in map.Stars)
                {
                    <li class="universe-caption" data-caption="@placed.Star.Id"><strong>@placed.Star.Label</strong> @placed.Star.Caption</li>
                }
            </ul>
        </div>
    </div>
</section>
<section class="section section-skills-list" aria-label="All skills">
    <div class="container">
        <details class="skills-all" data-reveal>
            <summary>All skills, grouped</summary>
            <div class="grid">
                @foreach (var group in Model.Groups)
                {
                    <div class="skill-group">
                        <h3 class="skill-title">@group.Label</h3>
                        <partial name="_TagList" model="new TagListModel(group.Items, group.Label)" />
                    </div>
                }
            </div>
        </details>
    </div>
</section>
