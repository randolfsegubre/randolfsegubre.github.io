# Shared editor and analyzer settings so every contributor and the build agree.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,slnx,props}]
indent_size = 2

[*.{js,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# C# style: file-scoped namespaces (enforced in the build via EnforceCodeStyleInBuild).
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
# CA1711 flags any type name ending in "Stream". `CodeStream` is a visual lane of
# code lines in the page background, not a System.IO.Stream, so the naming rule does not apply.
dotnet_diagnostic.CA1711.severity = none

# Entity Framework migrations are generated code: the analyzers and style rules do not apply to them.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
